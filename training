import random

zdravi = 100
zasah = 24
obvaz = True
pocet_zasahu = 0

while zdravi > 0:
    if random.randint(1, 4) == 1:
        print("Uhnul jsem!")
        continue

    zdravi = zdravi - zasah
    pocet_zasahu = pocet_zasahu + 1

    if zdravi < 0:
        zdravi = 0

    print("Au! Zbývá: " + str(zdravi))

    if zdravi <= 5 and zdravi > 0 and obvaz:
        print("--- Používám lékárničku a jedu znova! ---")
        zdravi = 100
        obvaz = False

print("Padl jsem... Schytal jsem " + str(pocet_zasahu) + " zásahů.")