import random

zdravi = 100
zasah = 24
obvaz = True
pocet_zasahu = 0


má_vestu = True
zivotnost_vesty = random.randint(1, 5)  
print(f"Mám plátovou vestu! Vydrží {zivotnost_vesty} zásahů.")

while zdravi > 0:
    if random.randint(1, 4) == 1:
        print("Uhnul jsem!")
        continue

    pocet_zasahu = pocet_zasahu + 1

    
    if má_vestu and zivotnost_vesty > 0:
        zivotnost_vesty = zivotnost_vesty - 1
        print(f"Zásah do vesty! (Životnost vesty: {zivotnost_vesty})")
        
        
        if zivotnost_vesty == 0:
            print("!!! Vesta se rozbila !!!")
            má_vestu = False
    else:
        
        zdravi = zdravi - zasah
        if zdravi < 0:
            zdravi = 0
        print("Au! Zbývá zdraví: " + str(zdravi))

    
    if zdravi <= 5 and zdravi > 0 and obvaz:
        print("--- Používám lékárničku a jedu znova! ---")
        zdravi = 100
        obvaz = False

print("Padl jsem... Schytal jsem " + str(pocet_zasahu) + " zásahů.")
